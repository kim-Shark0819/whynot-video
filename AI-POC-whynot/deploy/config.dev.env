# 개발계(고객 계정 whynot-dev-eks) 오버레이 — 2026-10-19 고객 GitLab 정본화.
# 값은 ai-deploy whynot/dev 실제 매니페스트(.kiro/handoff/target/dev_*.yaml) 기준.
#
# base = config.env.example(통합계정 730335451955 값). 이 오버레이는 고객 개발 계정
# (089540175779) 으로 바꿔야 하는 키만 덮어쓴다. render.py 는 base 에 없는 키를
# 거절하므로 여기 키는 모두 config.env.example 에 존재한다.
#
# **ingress · namespace 는 렌더 대상이 아니다.** 개발 ALB 는 gitlab-whynot ·
# argocd-whynot 와 한 ALB 그룹을 공유한다. group.name/group.order 와 host 는
# k8s/ingress.yaml.tmpl 에 없어 렌더로 만들 수 없고, namespace 는 ArgoCD 의
# CreateNamespace 가 만든다. 그래서 compare 의 ingress/namespace 차이는 의도된
# 것이며 config.dev.env 에 억지로 맞추지 않는다. CI 의 deploy:whynot:dev 도
# 이 두 파일을 건드리지 않고 service-account · model-catalog · workloads 3개만 쓴다.
#
# 비밀값은 여기 없다. 관리자 비밀번호·시드 사용자·회사 코드·API 키는 고객 개발
# 클러스터의 Secret 에만 있고 매니페스트는 그것을 참조만 한다.

# --- 계정 (고객 개발) ---
# 앱이 도는 계정. account_guard 의 EXPECTED_ACCOUNT_ID 와 service-account role-arn,
# 이미지 레지스트리 계정(ECR_ACCOUNT_ID 가 비어 있어 이 값으로 파생)이 모두 이 값을 쓴다.
AWS_ACCOUNT_ID=089540175779

# --- IAM (고객 개발) ---
# service-account 의 eks.amazonaws.com/role-arn 이
# arn:aws:iam::089540175779:role/whynot-dev-app-role 이 되게 한다.
IAM_APP_ROLE_NAME=whynot-dev-app-role

# --- 저장소 (고객 개발) ---
S3_BUCKET=whynot-dev-089540175779
# 영상 raw 출력 버킷(us-west-2). 모델과 같은 리전의 고객 개발 버킷.
S3_VIDEO_BUCKET=whynot-dev-video-089540175779-usw2
# live 개발 매니페스트에는 legacy 버킷이 없다(None). 빈 값으로 둔다 — workloads 의
# S3_VIDEO_LEGACY_BUCKET env 가 빈 값이 되어 live 와 일치한다.
S3_VIDEO_LEGACY_BUCKET=

# --- Neptune (고객 개발 그래프) ---
NEPTUNE_ENDPOINT=whynot-dev-graph.cluster-cdqeg08woy0c.ap-northeast-2.neptune.amazonaws.com

# --- 컨테이너 이미지 (고객 개발 ECR) ---
# ECR_ACCOUNT_ID 는 base 에서 비어 있어 AWS_ACCOUNT_ID(089540175779)로 파생된다.
# 리포 이름만 개발용으로 덮어써 089540175779.dkr.ecr.ap-northeast-2.amazonaws.com/
# whynot-dev-app|whynot-dev-frontend:<tag> 가 되게 한다.
ECR_APP_REPO=whynot-dev-app
ECR_FRONTEND_REPO=whynot-dev-frontend

# --- 모델 카탈로그 outputBucket (이번 수정의 목적) ---
# model-catalog 의 luma-ray2.outputBucket · workloads 의 VPOC_VIDEO_BUCKET 이 모두
# 이 값을 쓴다. base 는 통합계정 버킷(whynot-video-730335451955-us-west-2)이라
# 고객 개발 계정에서 돌면 AccessDenied 가 난다. 고객 개발 버킷으로 바꿔
# 실동작 통합계정 의존을 없앤다. 리전(VPOC_VIDEO_REGION)은 us-west-2 그대로다.
VPOC_VIDEO_BUCKET=whynot-dev-video-089540175779-usw2

# --- vpoc 영상 모델 고르기 (개발계) ---
# live 개발 매니페스트에서 켜져 있다. base 기본값은 false 라 여기서 true 로 덮어쓴다.
VPOC_MODEL_PICKER_ENABLED=true

# --- dual-style(실사+애니, 설계자 2026-10-20, 개발계) ---
# 화풍을 고르지 않고 실사 + 애니(웹툰풍) 두 결과를 함께 만든다. base 기본값 false 를 true 로 덮어쓴다.
# 모델·단가(VPOC_ANIME_MODEL·VPOC_ANIME_USD_PER_S)는 base 기본값 그대로 쓴다. 변환은 FAL_KEY 가
# 있어야 돈다(없으면 애니 결과에 "변환 키 없음", 실사는 정상).
VPOC_DUAL_STYLE_ENABLED=true

# --- 영상만들기_신규(vnew, 설계자 2026-10-20, 개발계) ---
# 새 영상 기능 틀. base 기본값 false 를 개발계에서만 true 로 덮어쓴다 — 만들기 창의
# "영상만들기_기존/신규" 두 버튼, 메뉴 "캐릭터 만들기", 빈 화면(vnewView·charactersView)과
# /api/vnew·video_new 트랙이 개발계에서만 열린다. 운영(config.prod.env)은 false 그대로다.
VNEW_ENABLED=true
# 캐릭터 만들기(vnew) 세부 단가·크기·3D 설정은 코드 기본값(app/src/vnew/settings.py)을 그대로
# 쓴다 — 개발계에서 바꿀 값이 없다. 바꾸려면 config.env.example 의 VNEW_* 주석을 참고한다.

# --- 기본 텍스트 모델(설계자 2026-10-28 "개발에만 상위 모델로 변경") ---
# 호출부가 모델을 넘기지 않는 단계(claude.plan · safe_image_prompt · revise 등)의 1순위. base 는 Sonnet 4.5.
# 개발계에서만 Fable 5.1 로 올린다(체인: Fable 5.1 → Opus 5.5 → Opus 4.6 → Sonnet 4.6 → Sonnet 4.5). 운영은 base 그대로.
VPOC_TEXT_MODEL=global.anthropic.claude-fable-5-1
