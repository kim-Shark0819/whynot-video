# AI-POC 환경 설정 견본
#
# 실물 config.env 는 저장소에 없다. 내장 계정 비밀번호가 평문으로 들어가기 때문이다.
# 클론한 뒤 이 파일을 복사해서 값을 채운다.
#
#   Copy-Item AI-POC/deploy/config.env.example AI-POC/deploy/config.env
#
# <...> 로 표시된 값만 채우면 된다. 나머지는 현재 계정의 실값이다.
#
# **이 파일은 CI 의 렌더 원본이기도 하다.** .gitlab-ci.yml 의 deploy:ai-poc 잡이 이 파일 +
# config.prod.env 로 k8s/*.tmpl 을 렌더링해 ai-deploy 저장소에 커밋하고 ArgoCD 가 배포한다.
# 그래서 비밀값이 아닌 실값은 여기에 있어야 한다(비어 있으면 CI 렌더 결과에도 비어 있다).
# 비밀값(ADMIN_PASSWORD, SEED_USERS, DEFAULT_COMPANY_CODE)은 템플릿이 참조하지 않고
# Secret(AUTH_SECRET_NAME)의 키로 클러스터에만 있다.
#
# 형식: KEY=VALUE (따옴표 없이, 주석은 #)
# 주의: PowerShell 의 Get-Content/Set-Content 로 이 파일을 편집하지 말 것.
#       기본 ANSI 해석이 한글 주석 뒤 줄바꿈을 삼켜 다음 줄의 KEY=VALUE 가 주석에 합쳐진다.

# --- 계정 / 리전 ---
AWS_ACCOUNT_ID=730335451955
AWS_REGION=ap-northeast-2
# 이미지를 가져올 ECR 계정. 비우면 AWS_ACCOUNT_ID 를 쓴다(개발계는 비운다).
# 고객사 운영 배포에서만 채운다 — 앱은 고객 계정에서 돌고 이미지는 우리 계정 ECR 에서 당겨온다.
ECR_ACCOUNT_ID=

# 자격증명 JSON 경로 (워크스페이스 루트 기준). 액세스 키가 평문이라 이 파일도 저장소에 없다.
CREDENTIALS_FILE=통합계정.json
# accounts_list 에서 이 access_name 을 찾아 쓴다. 인덱스로 고르지 않는다.
# 항목 순서가 바뀌면 조용히 다른 계정의 키를 집어 들기 때문이다.
CREDENTIALS_ACCESS_NAME=kiro-iam-mtx

# --- EKS ---
#
# ## 클러스터별 오버레이
#
# 대상마다 다른 값은 deploy/config.<target>.env 에 두고 이 파일 위에 덮어쓴다.
# 그 파일은 비밀값이 없어 저장소에 추적된다.
#
#   EKS_CLUSTER_NAME  EKS_OIDC_ID  EKS_CLUSTER_SECURITY_GROUP
#   IAM_APP_ROLE_NAME  IAM_APP_POLICY_NAME  ALB_NAME
#   NEPTUNE_ENDPOINT  NEPTUNE_CLUSTER_ID  NEPTUNE_SECURITY_GROUP  APP_DOMAIN
#
# 현재 대상은 하나다.
#
#   powershell -File AI-POC/deploy/deploy.ps1            # prod 가 기본값
#   powershell -File AI-POC/deploy/deploy.ps1 -Target prod
#
# **dev 대상은 제거했다.** `Dev-AI-POC-eks` 를 삭제해서 배포할 곳이 없다.
# 구조를 남기는 이유: 값을 클러스터별로 분리하지 않은 것이 이 파이프라인의 버그
# (호출부와 build-deploy.sh 의 필수값 목록이 어긋난 것)를 만든 원인이었고,
# Phase 5 의 고객사별 배포에서 같은 구조가 다시 필요하다.
#
# 아래 값은 오버레이가 없을 때 쓰이는 기본값이다.
EKS_CLUSTER_NAME=AI-POC-eks
# aws eks describe-cluster --query cluster.identity.oidc.issuer 의 마지막 경로 값
EKS_OIDC_ID=2A49105728911261AD4F240BFD9A8AB1
EKS_CLUSTER_SECURITY_GROUP=sg-022e24e853dfdc241
# EKS API 가 프라이빗 전용이라 이 배스천을 통해 kubectl 을 실행한다.
BASTION_INSTANCE_ID=i-0ca57a18e69b73a1f

# --- 네트워크 ---
VPC_ID=vpc-0de9ff1693bd56f38
PUBLIC_SUBNET_IDS=subnet-0b8b4832085705b56,subnet-07db8faf09bcfcdbb,subnet-053f2f798359b197a
# 화면(frontend)·앱(app) 파드를 띄울 AZ 목록(쉼표로 잇고 공백 없이). k8s/workloads.yaml.tmpl 의 두 Deployment 가
# nodeAffinity(topology.kubernetes.io/zone In 이 목록)로 쓴다. ALB 서브넷(PUBLIC_SUBNET_IDS)과 같은 AZ 만 적는다.
# 다르면 ALB(target-type ip)가 그 AZ 의 파드를 대상으로 쓰지 못해(Target.NotInUse) 503 이 난다
# (2026-10-31 운영: ALB 는 2a·2c 인데 새 frontend 파드 2개가 모두 2b 노드에 놓였다).
# 2026-11-07 부터 개발(config.dev.env)·운영(config.prod.env) 모두 2a·2c 로 덮어쓴다(2b 제외, 개발 ALB 도 2a·2c).
# 이 기본값(2a·2b·2c)은 오버레이 없이 렌더할 때만 쓰인다.
# 두 Deployment 는 이 목록 안에서 노드가 있는 영역마다 파드를 고르게 나눈다(영역 분산 DoNotSchedule, 지시서 106).
POD_ZONES=ap-northeast-2a,ap-northeast-2b,ap-northeast-2c
PRIVATE_SUBNET_IDS=subnet-01e0e91f3c43b57f2,subnet-071250e072cc06c64,subnet-0ac1a0b3cf1fb3c1f

# --- DNS / TLS ---
# 세 값이 비어 있으면 Ingress 가 80 리스너만 만든다. 도메인이 생기면 채운다.
# k8s/ingress.yaml.tmpl 에 되돌릴 세 줄이 주석으로 적혀 있다.
APP_DOMAIN=dev-whynot.meta-clouds.com
ROUTE53_HOSTED_ZONE_ID=Z0217882389GDS0BZDMYR
ACM_CERTIFICATE_ARN=arn:aws:acm:ap-northeast-2:730335451955:certificate/9fd7fdac-7ed2-45e4-a810-6399803da5e4

# --- 스토리지 ---
S3_BUCKET=whynot-730335451955
# Bedrock 영상 모델은 서울에 없다. 비동기 출력 버킷은 모델과 같은 리전이어야 한다.
#
# `terraform/hub/28-whynot` 이 만든다(2026-09-15 apply: 1 imported · 7 added ·
# 1 changed · 0 destroyed). 같은 레이어가 `whynot-s3-access` 를 관리로 가져와
# v2 에 이 버킷 ARN 을 넣었다 — 그전에는 `RestrictToProjectBucketsOnly` 의
# `Deny s3:*` 가 이 버킷 호출을 전부 막고 있었다.
#
# **AI-POC 의 버킷을 공유하지 않는 이유.** provider 출력 prefix 기본값이
# `_smoke/<provider>/shot-<n>`(`bedrock_luma.py:253`)이라 테넌트 키가 없다.
# 고객 둘이 같은 버킷에 쓰면 같은 키를 덮어쓴다. 수명주기 규칙도 `users/` ·
# `_smoke/` prefix 를 전제한다.
# active 출력 버킷. 2026-09-19 에 us-west-2 에서 us-east-1 로 옮겼다 — Reel 전환(B3) 때문이다.
# 비동기 출력은 **모델과 같은 리전의 버킷만** 받으므로 provider 리전과 반드시 짝이다.
# 개발계 provider 는 Luma(us-west-2)다. Bedrock 비동기 출력은 **모델과 같은 리전의
# 버킷만** 받으므로 이 값이 provider 리전과 함께 움직여야 한다. us-east-1 은 Nova Reel
# 시절 값이고 지금은 legacy 다 (실측: readiness 의 버킷 판정이 계속 실패해 영상 제출이
# blockedBy=["environment"] 로 막혔다).
S3_VIDEO_BUCKET=whynot-video-730335451955-us-west-2
# 이전 active 였던 두 번째 출력 버킷. 기존 결과물이 여기 있어 **읽기로 남긴다.**
# `render.py` 가 비면 위 버킷으로 대체하므로, 비우면 옛 결과물을 못 읽는다.
S3_VIDEO_LEGACY_BUCKET=whynot-video-730335451955-us-east-1
# 두 번째 버킷에 쓰기를 줄지. 새 생성은 active 로만 나간다.
S3_VIDEO_LEGACY_WRITABLE=false
VIDEO_OUTPUT_REGION=us-west-2
# 텍스트→기준 이미지 생성 모델은 영상 모델과 독립적으로 호출한다.
# `model-catalog` 의 Stability 모델과 `COVER_IMAGE_REGION` 에 함께 주입된다.
# 이 키가 없으면 영상 리전 설정을 따라가 Stability 모델 ID 가 invalid 로 거부된다.
IMAGE_MODEL_REGION=us-west-2
# 한 요청에 쓸 수 있는 참고 이미지 수. 20 이 기술 상한이다(Bedrock Converse 가
# 요청당 이미지 20장까지만 받는다). 이 값이 단일 원본이다.
VIDEO_MAX_REFERENCE_IMAGES=20

# --- 장면 영상화 provider (scene_video) ---
#
# `k8s/workloads.yaml.tmpl` 이 이 키들을 `${...}` 로 참조한다. 키가 없으면
# CI 의 미치환 검사에 걸려 deploy:whynot:dev 가 실패한다.
#
# **AI-POC 와 같아졌다(2026-09-19).** AI-POC 는 실측으로 active 를 Reel(us-east-1) +
# 애니 키프레임 조합으로 바꿨다 — 카메라 고정과 인물 동작을 동시에 만족한 유일한
# 조합이고, Luma 는 네 구성 모두 카메라를 잡지 못해 신규 생성에서 제외했다.
# whynot 도 이제 같은 조합이다. 전제였던 두 가지를 B3 에서 만들었다.
#   - 버킷 `whynot-video-730335451955-us-east-1` (us-east-1, AI-POC 버킷과 공유하지 않는다)
#   - `whynot-s3-access` v3 — 새 버킷 Allow 3문장 + RestrictToProjectBucketsOnly Deny 완화
# 둘 다 CLI 로 직접 만들었고 Terraform 편입은 후속 작업이다.
# 기록: docs/run-log/story-video-rebuild/aws-direct-changes.md
#
# 기본 provider. 허용 목록 안에 있어야 한다.
#
# 개발계를 Luma Ray2 로 옮긴다. 두 가지 이유다.
#
#   1. Nova Reel v1.1 은 LEGACY 이고 EOL 이 2026-09-30 이다. 남은 기간이 짧다.
#   2. 프롬프트 한도가 512 → 5,000자다. Reel 의 512자 때문에 인물 특징·행동·카메라를
#      담다가 잘려 나갔다. 그 압축이 품질을 깎는 가장 큰 원인이었다.
#
# 출력 버킷은 `providers.output_bucket_for` 가 리전으로 고른다. us-west-2 버킷이
# `S3_VIDEO_LEGACY_BUCKET` 에 이미 있으므로 Luma(us-west-2)가 맞는 것을 받는다.
# 이미 만들어진 Nova Reel 결과는 실행 기록에 `outputBucket` 이 남아 그대로 읽힌다.
SCENE_VIDEO_PROVIDER=bedrock_luma
# 허용 목록(쉼표). 여기 없는 이름을 요청하면 거부된다 — 오타나 실험용 경로가
# 운영에 켜지는 것을 설정 단계에서 막는다.
SCENE_VIDEO_ALLOWED_PROVIDERS=bedrock_luma,bedrock_reel
# 자리표시자(단색 카드) 허용 여부. **운영에서는 반드시 false 다**(D-A04).
# true 로 두면 "생성 완료"라고 표시된 파란 화면이 사용자에게 나간다.
SCENE_VIDEO_ALLOW_STUB=false
# 자체 GPU(Wan 2.2) 경로. 서버측 스위치다 — UI 숨김만으로는 API 직접 호출을 막지 못한다.
# 이 디렉터리는 GPU 를 이관하지 않았으므로 false 다.
SCENE_VIDEO_GPU_ENABLED=false
# 같은 provider/model/region/bucket/source revision 의 최근 성공을 준비 완료로 인정하는 기간.
# 기간이 지나도 readiness 가 유료 호출을 자동 실행하지는 않고 unverified 로 표시한다.
SCENE_VIDEO_VERIFICATION_TTL_SECONDS=604800

# --- Neptune (그래프: 사용자/프로젝트) ---
# 아직 만들지 않았다. 인프라가 생성한 뒤 실제 엔드포인트로 갱신한다(docs/새-고객-추가.md §4 예상값).
# 없으면 로그인과 프로젝트가 동작하지 않는다.
NEPTUNE_ENDPOINT=whynot-graph.cluster-cd0q2kk4wlbo.ap-northeast-2.neptune.amazonaws.com
NEPTUNE_PORT=8182
NEPTUNE_CLUSTER_ID=whynot-graph
NEPTUNE_SECURITY_GROUP=sg-05401ae26d7660ee5
# 회원가입 시 요구되는 회사 고유 코드의 초기값. 이후 관리자가 화면에서 변경한다.
DEFAULT_COMPANY_CODE=<회사코드>
# 내장 계정. 이 값이 단일 원본이며 기동할 때마다 비밀번호를 여기에 맞춘다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<관리자비밀번호>
# 내장 일반 사용자 (username:password 쉼표 구분)
SEED_USERS=<사용자1:비밀번호1,사용자2:비밀번호2>
# 결과물 생성 한도. `사용자:video=건수,asset=건수` 이고 사용자끼리는 세미콜론으로 나눈다.
# 비어 있으면 전원 무제한. 계정을 처음 만들 때만 적용되고 그 뒤로는 관리자 화면이 최종 값이다.
USER_QUOTAS=

# --- 컨테이너 이미지 ---
ECR_FRONTEND_REPO=whynot-frontend
ECR_APP_REPO=whynot-app
# GPU 노드를 두지 않기로 해서 Wan 2.2 추론 서버는 이관하지 않았다. 비워 둔다.
ECR_VIDEO_GEN_REPO=
VIDEO_GEN_TAG=
# ECR 태그가 immutable 이라 같은 태그로 재푸시할 수 없다. 새 배포는 새 태그를 쓴다.
IMAGE_TAG=<YYYYMMDD-vN>

# --- GPU 영상 워커 (config.prod.env 가 실값을 덮어쓴다. 여기서는 키만 둔다) ---
# render.py 는 오버레이에만 있는 키를 거절하므로 config.env 에 키가 있어야 한다.
GPU_NODEGROUP_NAME=ai-poc-video-gpu-4xl
VIDEO_WORKER_REPO=dev-ai-poc-video-worker
VIDEO_WORKER_TAG=wan22-v11
VIDEO_CLIP_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/730335451955/whynot-video-clip
# k8s-gpu/*.tmpl 이 참조한다. GPU 노드가 없는 대상에서도 render.py 가 전체 템플릿을 렌더링하므로 키가 있어야 한다.
# GPU 노드그룹 ai-poc-video-gpu-4xl 은 ai-poc 와 공유한다(label workload=video-gpu, taint nvidia.com/gpu).
# max 1 이라 두 앱이 동시에 GPU 를 쓸 수는 없다. 평소 desired 0 이라 비용은 나지 않는다.
GPU_NODE_LABEL_KEY=workload
GPU_NODE_LABEL_VALUE=video-gpu
# k8s-gpu 의 나머지 참조 키. GPU 를 쓰는 대상에서 config.<target>.env 가 실값을 준다.
MODEL_PVC_SIZE=200Gi
WAN_MODEL_DIR=Wan2.2-I2V-A14B
WAN_MODEL_REPO=Wan-AI/Wan2.2-I2V-A14B

# --- Bedrock 모델 카탈로그 ---
MODEL_CATALOG_CONFIGMAP=whynot-models
MODEL_CATALOG_DIR=/etc/ai-poc
MODEL_CATALOG_PATH=/etc/ai-poc/models.json
MODEL_CONFIG_KEY=_config/models.json

# --- Kubernetes / IAM 이름 ---
K8S_NAMESPACE=whynot
APP_SERVICE_ACCOUNT=whynot-app
FRONTEND_DEPLOYMENT_NAME=whynot-frontend
AUTH_SECRET_NAME=whynot-auth
PROJECT_NAME=whynot
# 아래 세 값은 클러스터별 오버레이가 덮어쓴다 (위 "클러스터별 오버레이" 참고).
IAM_APP_ROLE_NAME=whynot-app-role
IAM_APP_POLICY_NAME=whynot-s3-access
# Ingress 의 alb.ingress.kubernetes.io/load-balancer-name 이 되는 값.
# 두 클러스터가 같은 이름을 쓰면 양쪽 컨트롤러가 같은 ALB 를 서로 고쳐 쓴다.
ALB_NAME=whynot-web-alb

# --- 파드 자원 (requests/limits) ---
# base(=개발계) 는 지금 값 그대로다. 운영은 노드를 m6i.2xlarge 로 키웠으므로 config.prod.env 가
# 더 큰 값으로 덮어쓴다(설계자 2026-10-19). CPU 는 workloads.yaml.tmpl 에서 따옴표로 감싸 YAML 문자열로 넣는다.
FRONTEND_CPU_REQUEST=50m
FRONTEND_MEM_REQUEST=64Mi
FRONTEND_CPU_LIMIT=200m
FRONTEND_MEM_LIMIT=128Mi
APP_CPU_REQUEST=100m
APP_MEM_REQUEST=128Mi
APP_CPU_LIMIT=500m
APP_MEM_LIMIT=512Mi
# app Deployment 파드 수 (2026-11-07). 운영은 config.prod.env 에서 덮어쓴다.
APP_REPLICAS=2

# --- 롤링 업데이트 무중단 (preStop / 종료 유예) ---
# 롤링 중 약 4초간 502 가 났다. 파드가 SIGTERM 을 받고 즉시 닫히는데 ALB 대상 그룹의
# 등록 해제(deregistration)는 몇 초 늦어, 그 사이 ALB 가 죽어가는 파드로 보낸 요청이 502 가 됐다.
# preStop 으로 종료 직전 잠시 대기해 ALB 가 대상을 빼낼 시간을 준 뒤 프로세스를 내린다.
# sleep 뿐이라 readOnlyRootFilesystem 과 충돌하지 않고, app(python slim)·frontend(nginx-unprivileged)
# 이미지 모두 sh 를 가진다. 종료 유예(terminationGracePeriodSeconds)는 preStop 대기 + 진행 중
# 요청 처리 시간을 포함해야 하므로 preStop 보다 길게 둔다. 개발계에 들어가도 무해하다.
PRESTOP_SLEEP_S=15
TERMINATION_GRACE_S=45

# --- 배포 경로 ---
# argocd 이면 deploy.ps1 이 거부한다. 배포는 main 푸시 -> CI -> ArgoCD. (config.<target>.env 가 정한다)
DEPLOY_MANAGED_BY=argocd

# --- Whynot PRD 9단계 개발 미리보기 ---
# frontend와 backend를 같은 값으로 게이트한다. 운영 overlay는 false로 덮어쓴다.
VIDEO_GEN_ENABLED=true
# 스토리 개발 트랙. 기본 true이고 환경별로 영상 트랙과 독립적으로 끌 수 있다.
STORY_DEV_ENABLED=true
# 영상만들기_신규(vnew, 설계자 2026-10-20). 웹툰 이미지 → 콘티·영상의 새 영상 기능. 지금은 틀만이다.
# 켜지면 만들기 창에 "영상만들기_기존/신규" 두 버튼과 메뉴 "캐릭터 만들기", 빈 화면이 보이고
# /api/vnew 와 video_new 트랙이 열린다. 기본 false(운영 그대로), 개발 overlay(config.dev.env)만 true.
VNEW_ENABLED=false
# vnew 가 켜졌을 때 만들기 창의 story(스토리) 버튼을 숨길지(2026-10-30). 화면(runtime-config vnewHideStory)만 쓰고 앱 env 에는 없다.
# 기본 true(지금 동작: 숨김. 기존 story 프로젝트는 목록·열기 그대로). 운영 overlay(config.prod.env)는 false(새 스토리 만들기 유지).
VNEW_HIDE_STORY=true
# 프리비즈 소품 관통 보정(084 R1, 2026-10-28). 서버가 앉을 소품·엉덩이 높이·다리 방향을 정하고 인물↔소품
# 겹침을 밀어낸다(설계 저장 전·보기 때 사본). 되돌리기: config.<target>.env 에 VNEW_PREVIZ_COLLISION=false.
VNEW_PREVIZ_COLLISION=true
# 프리비즈 받침 판단 반영(previz-support-reasoning, 2026-10-29). 패널에서 읽은 받침(자세·물체·높이·앉는 방식·발)을
# 장면 설계 프롬프트에 넣고 서버가 앉을 소품·윗면 높이를 맞춘다. 되돌리기: config.<target>.env 에 VNEW_PREVIZ_SUPPORT=false
# (다음 설계부터 지금 동작. 이미 저장된 장면은 그대로).
VNEW_PREVIZ_SUPPORT=true
# 만화 기호·분위기(vnew-live-fx 묶음 A, 2026-10-30). ③ 콘티 컷마다 기호·분위기 한 줄을 두고 상위 모델 1회로 채운다.
# 기호·분위기만 고친 저장은 프리비즈 승인을 풀지 않는다. 되돌리기: config.<target>.env 에 VNEW_FX=false
# (채우기 라우트 404·저장 정규화 없음·영상 프롬프트 그대로. 이미 저장된 기호·분위기는 지우지 않는다).
VNEW_FX=true
# 실사 캐스팅(vnew-live-fx 묶음 B, 2026-10-30). 캐릭터 상세에서 실사 배우 사진을 글로만 뽑아 고르고(현실 배우풍 장당 $0.04·
# 아이돌풍 $0.075, 지시서 109), 캐릭터 분석에 성별을 더한다. 되돌리기: config.<target>.env 에 VNEW_CASTING=false
# (캐스팅 라우트 404·분석 도구·SYSTEM 그대로. 진행 중 뽑기는 끝까지 하고, 저장된 캐스팅 사진은 지우지 않는다).
VNEW_CASTING=true
# 통 테이크 실사 버전(vnew-live-fx 묶음 C, 2026-10-30). 웹툰 통 테이크가 끝난 gen 에서 같은 프리비즈 녹화로 실사 버전을
# 만든다(480p 15초 ≈ $3.08). 되돌리기: config.<target>.env 에 VNEW_TAKE_REAL=false
# (실사 버전 시작 404. 이미 시작한 실사 회차는 끝까지 하고, 소리 거절 안내·다시 만들기는 그대로다).
VNEW_TAKE_REAL=true
# 캐릭터 충실도(char-fidelity, 2026-10-30). 기본 복장을 기준 사진 한 장 그대로 정하고, 한쪽 소품 좌우를 코드가 정하고,
# 시트를 45°씩 도는 다섯 인물로 그린다. 되돌리기: config.<target>.env 에 VNEW_CHAR_FIDELITY=false
# (분석·프롬프트·검사가 지금 그대로. 이미 만든 캐릭터는 그대로 둔다).
VNEW_CHAR_FIDELITY=true
# 3D 옆모습(char-fidelity, 2026-10-30). variant 마다 옆모습 2장(Seedream 장당 $0.04)을 더 그려 3D 에 보낸다.
# 되돌리기: config.<target>.env 에 VNEW_3D_SIDE_VIEWS=false (3D 에 정면·후면만 보낸다).
VNEW_3D_SIDE_VIEWS=true
# 3D 공급자(char-fidelity T2b, 2026-10-30). 기본 Tripo H3.1(fal). 같은 정면·후면으로 비교했을 때 두 그림체 모두 사진과 가장 가까웠다
# (Hunyuan3D v3 는 앞머리 덩어리·부은 얼굴). 되돌리기: config.<target>.env 에 VNEW_3D_PROVIDER=hunyuan
# (T2 의 Hunyuan3D v3 본문·원장 그대로. 진행 중 요청은 requestArn 의 endpoint 로 조회한다). 아래 값이 틀리면 기본값 + 경고 로그 1줄.
VNEW_3D_PROVIDER=tripo
# 다시점(정면·왼쪽·후면[·오른쪽]) / 단일(정면만) endpoint. "tripo3d/<버전>/<작업>" 꼴만 받는다.
VNEW_3D_TRIPO_ENDPOINT=tripo3d/h3.1/multiview-to-3d
VNEW_3D_TRIPO_SINGLE_ENDPOINT=tripo3d/h3.1/image-to-3d
# 면 수 상한(10000~1000000). 300000 이면 GLB 약 12MB, 제한하지 않으면 약 190만 면·58MB(Claude 실측 2026-10-30).
VNEW_3D_TRIPO_FACE_LIMIT=300000
# standard 또는 detailed.
VNEW_3D_TRIPO_TEXTURE_QUALITY=detailed
VNEW_3D_TRIPO_GEOMETRY_QUALITY=detailed
# Tripo 입력 정사각 한 변(512~4096, 흰 배경 패딩). Hunyuan 은 VNEW_3D_INPUT_SQUARE(1024) 그대로.
VNEW_3D_TRIPO_INPUT_SQUARE=2048
# false 면 옆모습이 있어도 단일(정면만) endpoint 로 보낸다.
VNEW_3D_TRIPO_MULTIVIEW=true
# Tripo 결과 정면(+X)을 화면 정면(+Z)으로 돌리는 Y축 각도(-360~360). 0 이면 돌리지 않는다.
VNEW_3D_TRIPO_YAW_DEG=-90
# Tripo 1건 단가(원장). 근거: fal 가격표 2026-10-30 HD 텍스처 $0.40 + detailed 형상 $0.20.
VNEW_3D_TRIPO_USD=0.60
# Tripo 다시점 왼쪽·오른쪽 자리 바꾸기. 개발계 확인에서 GLB 좌우가 반대면 config.<target>.env 에 VNEW_3D_SIDE_SWAP=true.
VNEW_3D_SIDE_SWAP=false
# 추가 복장 멈춤 판단(지시서 102 피드백, 2026-10-30). 그리기(images)가 시작부터 이 초를 넘으면 멈춘 것으로 보고 상세에 실패로 보이며,
# 다시 만들기를 409 없이 받는다(경고 로그 vnew.outfit.stale_restart). 정상 1벌은 Seedream 4장으로 10분 안쪽이다. 60 아래는 60.
VNEW_OUTFIT_STALL_S=1200
# BL 유형 참고 외모(지시서 103·104, 2026-10-31). 캐릭터 설명(추가 요청)에 적힌 BL 유형(떡대공·미인수 등)을 실사 캐스팅 문장 끝에
# 참고 문장으로 더한다(그림 사실이 이긴다, 비용 변화 없음). 되돌리기: config.<target>.env 에 VNEW_BL_LOOK=false
# (보기에 BL 줄 없음·캐스팅 문장 그대로. 캐릭터 설명은 지우지 않는다).
VNEW_BL_LOOK=true
# 실사 사진 검사(지시서 107, 2026-11-01). 캐스팅 결과 사진마다 저장 전에 비전 LLM 1회로 실사인지 묻고, 그림체(웹툰·일러스트·애니·3D)면
# 그 사진을 버리고 그 칸만 같은 문장으로 두 번까지 다시 뽑는다(버린 장도 원장에 남는다, 그 회차 장당 금액). 검사 모델은 코드 기본
# VNEW_CAST_PHOTO_CHECK_MODEL(기본 = VNEW_PEOPLE_COUNT_MODEL). 되돌리기: config.<target>.env 에 VNEW_CAST_PHOTO_CHECK=false
# (검사·다시 뽑기 없음. 캐스팅 문장 끝 사진 고정 문장은 그대로 붙는다).
VNEW_CAST_PHOTO_CHECK=true
# 아이돌풍 실사 캐스팅 모델(지시서 109, 2026-11-01). 아이돌풍만 이 fal 모델(FLUX.2 [pro], 장당 $0.075)로 뽑고, 현실 배우풍은
# Seedream 4.5(VNEW_CASTING_MODEL, 장당 $0.04) 그대로다(개발 비교 실사 비율: Seedream 6장 중 1장, FLUX.2 [pro] 6장 중 6장). 장당 금액
# VNEW_CASTING_IDOL_USD(0.075)·크기 VNEW_CASTING_IDOL_SIZE(1760x2352)는 코드 기본(app/src/vnew/settings.py, 템플릿에 없음).
# 되돌리기: config.<target>.env 에 VNEW_CASTING_IDOL_MODEL= (빈 값 한 줄 — 아이돌풍도 Seedream 모델·장당 금액·크기.
# 진행 중 회차는 시작 때 남긴 모델·금액으로 끝까지 한다).
VNEW_CASTING_IDOL_MODEL=fal-ai/flux-2-pro
# ⑦ 편집 — 영상 편집 타임라인(지시서 110, 2026-11-01). ⑤에서 만든 영상을 클립으로 늘어놓고 자르기·나누기·순서·소리 끄기를 고쳐
# 서버 ffmpeg 로 mp4 하나로 내보낸다(유료 생성 API 호출 없음, 비용 0). 되돌리기: config.<target>.env 에 VNEW_EDIT=false
# (편집 라우트 404·gen 보기에 edit 요약 없음 = ⑦ 단계 없음. 진행 중 내보내기는 끝까지 하고, 저장된 문서·결과 영상은 지우지 않는다).
# 운영 overlay(config.prod.env)는 false 다(개발에서 먼저 시험).
VNEW_EDIT=true
# 인터넷 외모 용어 웹 검색 풀이(지시서 113, 2026-11-02). 켜고 Brave Search API 키 Secret(아래 BRAVE_SECRET_NAME)도 있으면, 실사 캐스팅 뽑기가 첫 제출
# 전에(백그라운드) 캐릭터 설명에서 코드 표에 없는 외모 인터넷 용어(최대 3개)를 LLM 으로 뽑고, 용어마다 Brave 웹 검색 1회(질의는 용어 하나뿐)와 해석 LLM 1회로
# 영어 외모 조각(용어당 최대 2개)을 만들어 캐스팅 문장 참고 문장 끝에 붙인다. 사용자별 용어 캐시 30일(S3 글). 기본 false — 키를 등록하기 전까지 지금 동작이다.
# 켜기: Secret 을 만든 뒤 config.<target>.env 에 VNEW_TERM_SEARCH=true (순서는 docs/plans/2026-11-02-brave-search-key.md). 되돌리기: 그 줄을 지우거나 false.
VNEW_TERM_SEARCH=false
# 용어 뽑기·해석 LLM. 빈 값이면 코드 기본(VNEW_PEOPLE_COUNT_MODEL = 그림 검사 모델, 실사 사진 검사 모델의 기본과 같다).
VNEW_TERM_MODEL=
# Brave Search API 키를 담을 k8s Secret 이름(지시서 113). 키 값은 Secret 의 brave-search-api-key 에만 두고(env BRAVE_SEARCH_API_KEY 로 주입) 이 파일에 적지
# 않는다. workloads.yaml.tmpl 이 optional 로 참조하므로 Secret 이 없어도 파드는 뜨고, 그때는 검색을 건너뛴다.
BRAVE_SECRET_NAME=brave-search-api-key
# ⑦ 편집 — AI로 고치기(지시서 116, 2026-11-02). ⑤ 영상 제출마다 최종 프롬프트·모델·매개변수·참고 이미지 S3 키를 gen 폴더 prompts.json 에 남기고,
# ⑦ 에서 테이크·컷 하나를 이전 프롬프트 + 결과 프레임 + 수정 요청으로 LLM 1회 고쳐 같은 모델로 새 버전을 만든다(유료 — 화면이 확인 금액을 받는다).
# 되돌리기: config.<target>.env 에 VNEW_EDIT_RETAKE=false (새 라우트 3개 404·⑦ 버튼 없음·기록 쓰기 없음. 진행 중 다시 만들기는 끝까지 하고,
# 저장된 기록·버전·결과 영상은 지우지 않는다). 운영 overlay(config.prod.env)는 false 다(사용자 승인 뒤 켬).
VNEW_EDIT_RETAKE=true
# 캐릭터 만들기(vnew, 설계자 2026-10-20) 세부 설정 — 전부 코드 기본값이 있어 생략해도 된다
# (app/src/vnew/settings.py). 아래 값을 바꾸고 싶을 때만 config.env 에 풀어서 쓴다.
# 단가는 원장(ledger)에 기록만 하고 생성은 막지 않는다. 템플릿(workloads.yaml.tmpl)에는
# ${...} 로 넣지 않았다 — 기본값으로 충분하고, 안 쓰는 치환을 만들지 않기 위해서다.
#   VNEW_SEEDREAM_USD=0.04          # Seedream 장당 단가(USD)
#   VNEW_3D_USD=0.375               # 3D 모델 1건당 단가(USD)
#   VNEW_3D_ENDPOINT=fal-ai/hunyuan3d-v3/image-to-3d   # 3D fal endpoint_id
#   VNEW_3D_FACE_COUNT=120000       # GLB 면 수(기본 500000 → 40MB 라 줄인다)
#   VNEW_ASTRA_MODEL=global.openai.gpt-6-astra          # 분석 1순위(실패 시 Claude 체인)
#   VNEW_SHEET_SIZE=2560x1440       # 5면 턴어라운드 시트 크기
#   VNEW_FRONT_SIZE=1440x2560       # 정면 전신 크기
#   VNEW_3D_INPUT_SQUARE=1024       # 3D 입력 정사각 한 변(흰 배경 패딩)
#   VNEW_3D_POLL_INTERVAL_S=5       # 3D 완료 폴링 간격(초)
#   VNEW_3D_POLL_MAX_S=900          # 3D 완료 최대 대기(초, 15분)
#   VNEW_MAX_SOURCES=8              # 업로드 웹툰 이미지 최대 장수
#   VNEW_MAX_ANALYSIS_IMAGES=6      # 분석에 보낼 이미지 수
#   VNEW_MAX_REFERENCE_IMAGES=4     # Seedream 참고 이미지 수
#   VNEW_BUILD_STALL_S=1800         # building 이 이 시간 넘게 멈추면 조회 때 failed(30분)
#   VNEW_CONTI_IMAGES=true          # ③ 콘티 요청에 웹툰 타일을 "Panel N of M:" 라벨과 함께 보냄(지시서 120, false 면 글만)
#   VNEW_SOUND=true                 # ⑥ 사운드 실제 말/속마음 반영(작업 122, 속마음 구간만 소리 효과·영상은 복사, false 면 라우트 404)
# 로그인 유지. true 이면 토큰을 localStorage 에도 두어 새 창·새 탭에서 다시 로그인하지 않는다.
# 만료는 서버 TOKEN_TTL_SECONDS 그대로다. 기본 false(탭마다 로그인), 운영 overlay 만 켠다(설계자 2026-10-07).
PERSIST_LOGIN=false
# 로그인 후 1회 안내 팝업(운영 노드 교체 안내). 로그인해 메인 화면이 뜨면 한 번만 보이고,
# 아이디별로 localStorage 에 닫은 시각을 남겨 다시 뜨지 않는다. 기본 false(개발계는 꺼짐),
# 운영 overlay 만 켠다(설계자 2026-10-19).
NOTICE_SPECUP_ENABLED=false
# --- 1단계 텍스트·로그 입력 확장 (텍스트 입력 확장 PRD §10.5) ---
# 두 스위치를 따로 둔다. 입력은 열어 두고 미검증 생성만 막을 수 있어야 한다.
#
# preview     1단계에 "캐릭터와 글로 만들기" 를 노출하고 초안 저장·복원을 허용한다.
#             저장·모드 전환·조회에 모델 호출이 없다.
# generation  텍스트 방식에서 **유료 생성**(계획 승인의 기준 이미지 · I2V)을 허용한다.
#             꺼져 있으면 서버가 409 로 거부한다. 화면을 숨기는 것으로 대신하지 않는다.
#             실영상 품질 검증을 통과한 뒤에 켠다. **웹툰 방식은 이 값과 무관하다.**
STORY_TEXT_INPUT_PREVIEW=true
STORY_TEXT_INPUT_GENERATION=true
# 새 legacy root·파괴 작업은 막고 기존 ID의 승인·취소·검수·재부착은 유지한다.
LEGACY_VIDEO_WRITE_MODE=drain
# live IAM에 전역 `_cache/video-analysis/` 권한을 추가하기 전까지 mock 분석은 cache 없이 실행한다.
VIDEO_ANALYSIS_CACHE_ENABLED=false
# 외부 SaaS(Seedance) 경로. 실제 계약이 확정되기 전에는 mock만 허용한다.
# **이야기 분석·기준 이미지 스위치가 아니다** — 아래 STORY_MODEL_MODE 가 그 자리다.
PROVIDER_MODE=mock
# 이야기 분석(video.story_understanding)·기준 이미지(video.keyframe_ref)가 우리 계정
# Bedrock 을 실제로 부를지. 개발계는 real 이다.
#
# PROVIDER_MODE 와 나눈 이유: 그 값은 "외부 vendor 계약이 없다" 는 뜻이고 seedance_client
# 가 읽는다. 두 뜻을 한 변수에 얹어 두면 계정 안의 Bedrock 호출 하나를 켜려고 외부 vendor
# 경로까지 함께 켜야 한다. 개발계의 다른 트랙(스토리·표지)은 이미 Bedrock 을 real 로
# 부르고 있어, 영상 분석만 mock 으로 남아 있는 것이 오히려 어긋난 상태였다.
#
# 운영 오버레이(config.prod.env)는 mock 으로 덮어쓴다. 운영은 VIDEO_GEN_ENABLED=false 라
# 영상 트랙 자체가 노출되지 않는다.
STORY_MODEL_MODE=real
# 법무 승인 전에는 원본·파생 웹툰 자산을 외부 provider로 보내지 않는다.
SEEDANCE_ALLOW_ORIGINAL_ASSETS=false

# --- 장면 영상화 (scene_video, Seedance 2.0) ---
# 붙였다 뗄 수 있는 독립 기능. app/src/scene_video/config.py 가 이 값을 읽는다.
# **아직 k8s/workloads.yaml.tmpl 은 이 값을 참조하지 않는다** — Phase 0(벤더 실측)이
# 끝나 API 키가 나오면 workloads.yaml.tmpl 에 env 항목으로 추가하고 여기 값을 채운다.
# 그 전까지는 코드 기본값(SEEDANCE_MODE=stub)이 그대로 적용되어 벤더를 호출하지 않는다.
# Seedance 2.0 은 **Bedrock 모델이 아니다.** AWS Marketplace SaaS 상품
# `prod-vdri6kfaqizps` 이고 호출은 BytePlus ModelArk 의 HTTPS API 로 나간다. 계약은
# License Manager 에 있다 (`aws license-manager list-received-licenses`).
#
# 상품 페이지가 밝힌 능력: 길이 4~15초 · 해상도 480P/720P/1080P/4K · 토큰 차감형
# (해상도·입력 방식에 따라 최대 약 1:1.8 차이) · 프라이빗 오퍼라 공개 단가 없음.
SEEDANCE_MODE=stub
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_MODEL_ID=dreamina-seedance-2-0-260128
ARK_MODEL_ID_FAST=dreamina-seedance-2-0-fast-260128
# 벤더 API 키를 담을 k8s Secret 이름. **이 파일에 키 값을 적지 않는다.**
SEEDANCE_SECRET_NAME=seedance-api-key
# 공식 API 본문 스키마를 확인했는가. false 면 코드가 live 제출을 거부한다.
SEEDANCE_SCHEMA_VERIFIED=false
# 계약 조건. 비면 금액·토큰을 계산하지 않는다 (단가를 추정하지 않는다).
SEEDANCE_CONTRACT_TOKEN_TOTAL=
SEEDANCE_CONTRACT_TOKEN_RATES=
SEEDANCE_CONTRACT_ENDS_AT=2026-10-09
# k8s Secret(예: seedance-api-key)의 키로 주입한다. config.env 에 실값을 적지 않는다.
ARK_API_KEY=
# fal.ai API 키를 담을 k8s Secret 이름(설계자 2026-10-18). 키 값은 Secret 의 fal-api-key 에만 두고
# 이 파일에 적지 않는다. workloads.yaml.tmpl 이 optional 로 참조하므로 Secret 이 없어도 파드는 뜬다.
FAL_SECRET_NAME=fal-api-key
# 원본 웹툰 이미지 외부 전송 정책. 서면 승인 전에는 test_only 를 유지한다(D-S06).
VENDOR_INPUT_POLICY=test_only

# --- vpoc1 영상 기능 (PRD 6.8) ---
# 정본: AI-POC-whynot/docs/vpoc1/PRD.md. VIDEO_GEN_ENABLED 가 꺼지면 이 값과 무관하게 꺼진다.
VPOC_ENABLED=true
# dev 에서만 AWS 오류 원문을 화면에 그대로 보인다(D-L06). 운영 전환 때 false.
VPOC_RAW_ERRORS=true
# 브라우저에서 영상 1건을 직접 만들어 보는 테스트 페이지(/vpoc-smoke.html). dev 전용.
VPOC_SMOKE_ENABLED=true
VPOC_TEXT_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# Bedrock 상위 모델 첫 시도 성공(llm-top-model-first, 2026-10-28). 모델 id 에 이 부분 문자열(쉼표 구분, 소문자 비교)이
# 들어 있으면 첫 요청부터 그 설정을 뺀다(2026-10-14 실측: Opus 5.x · Fable 5.x 는 강제 도구 · temperature,
# GPT-6 Astra 는 temperature 를 거절). 빈 값이면 미리 빼지 않고 예전처럼 거절을 겪은 뒤 적응한다(되돌리기).
VPOC_LLM_NO_FORCED_TOOL=claude-opus-5,claude-fable-5
VPOC_LLM_NO_TEMPERATURE=claude-opus-5,claude-fable-5,gpt-6
# 출력이 max_tokens 에서 잘려 도구 입력이 없으면, 다음 모델로 가기 전에 같은 모델로 min(max_tokens × FACTOR, CAP)
# 예산으로 한 번 더 부른다. 그 값이 원래 예산 이하면 다시 부르지 않는다. 끄려면 FACTOR=1.
VPOC_LLM_TRUNC_RETRY_FACTOR=4
VPOC_LLM_TRUNC_RETRY_CAP=4096
VPOC_IMAGE_MODEL=stability.sd3-5-large-v1:0
VPOC_IMAGE_REGION=us-west-2
VPOC_VIDEO_MODEL=luma.ray-v2:0
VPOC_VIDEO_REGION=us-west-2
# Luma 출력 버킷. 모델과 같은 리전이어야 한다. Gate 0 C6 에서 확인했다.
VPOC_VIDEO_BUCKET=whynot-video-730335451955-us-west-2
VPOC_RESOLUTION=540p
VPOC_DURATION=5s
VPOC_ASPECT=16:9
# 실측(2026-09-23 Gate 0 C8): Luma Ray V2 on-demand 동시 요청 쿼터 = 1.
# 2 이상으로 올리면 ThrottlingException 이 나고 샷이 queued 로 되돌아간다.
VPOC_MAX_INFLIGHT=1
VPOC_MAX_SHOTS=6
# 비용 상한은 없다(2026-09-23 사용자 결정, 지원 금액 8,000 USD).
# 원장은 기록만 하고 제출을 막지 않는다. 화면은 누적 금액만 보인다.
VPOC_TEXT_USD_PER_MTOK_IN=3
VPOC_TEXT_USD_PER_MTOK_OUT=15
# ④단계 "이 샷만 의견 반영해 다시 만들기"(regen-plan G6).
# 문제가 생기면 이 값만 false 로 바꿔 배포하면 새 액션 3개가 404 가 되고 화면 버튼도 사라진다.
VPOC_REGEN_ENABLED=true
# ② 영상 모델 고르기 — Luma Ray2 · Seedance 2.0 · 2.5 (설계자 2026-10-07, dev 만. mini·fast 는 뺐다).
# 기본 false(운영은 이 값 그대로 꺼진다). 고객 계정 dev 매니페스트에서만 true 로 켠다.
# Seedance 는 ARK_API_KEY(Secret seedance-api-key) 가 있어야 고를 수 있다. 모델 ID 가 빈 모델은 화면에 "미설정".
VPOC_MODEL_PICKER_ENABLED=false
VPOC_ARK_MODEL_2_0=dreamina-seedance-2-0-260128
VPOC_ARK_MODEL_2_5=dreamina-seedance-2-5-260628
# 생성 1초 USD 덮어쓰기. 비면 vpoc/settings.py 의 단가표(콘솔 견적에서 계산, 해상도별)를 쓴다.
VPOC_ARK_USD_PER_SEC_2_0=
VPOC_ARK_USD_PER_SEC_2_5=
VPOC_ARK_RESOLUTION=720p
# 기존(BytePlus ARK 직결) Seedance 사용 여부(073, 설계자 2026-10-26). 기본 false — ② 목록에서 빠지고
# 저장된 선택은 fal Seedance(등록 시) 또는 Luma 로 바뀐다. 진행 중인 ARK 회차(steps.4.videoModel 이
# seedance-*)는 이 값과 무관하게 BytePlus 로 끝까지 제출·조회된다. 되돌릴 때만 config.<target>.env 에
# VPOC_ARK_SEEDANCE_ENABLED=true 를 넣는다(오버레이는 이 파일에 있는 키만 덮을 수 있다).
# Secret seedance-api-key(ARK_API_KEY)는 지우지 않는다 — 진행 중 회차와 Seedream 이 같은 키를 쓴다.
# Seedream 그림(작업 124)은 코드 기본 VPOC_SEEDREAM_PROVIDER=fal(fal Seedream 4.5 edit·text-to-image, 장당 VPOC_SEEDREAM_FAL_USD=0.04)이다. 되돌리기: k8s 에 배선이 없어 vpoc/settings.py 기본을 ark 로 바꾼다(ark 인증 실패는 그 호출만 fal 로 넘긴다).
VPOC_ARK_SEEDANCE_ENABLED=false
# fal Seedance 계열(073 D2): ② 목록에는 얼굴(image-to-video) 하나("Seedance 2.5 (fal)")만 보이고, 제출 때
# 샷 방식에 따라 얼굴(i2v, 시작·끝 장면) 또는 짝(reference-to-video, 참고 그림·글만)으로 보낸다.
# 형식 얼굴=짝[,얼굴=짝…](endpoint id, fal: 없이). 얼굴은 짝도 등록돼 있어야 고를 수 있다.
# 빈 값이면 계열 라우팅을 끈다(070 동작: i2v 하나, 인물 그림이 시작 프레임). 형식이 틀린 항목은 버린다.
VPOC_FAL_SEEDANCE_FAMILY=bytedance/seedance-2.5/image-to-video=bytedance/seedance-2.5/reference-to-video
# fal Seedance 계열 샷·영상 1개 길이 상한(초, 073 D3). caps 는 4~30초지만 BytePlus 와 같은 15초로 묶는다.
# ③ 길이 선택지·한 번에 만들기 상한·generate(E2)·제출 검사가 이 값을 쓴다. 계열이 아닌 fal 모델은 영향 없음.
# 낮추면 이미 만든 ③ 계획(영상 1개)이 generate 에서 E2(BadDuration)로 막힐 수 있다 — ③을 다시 만든다.
VPOC_FAL_SEEDANCE_MAX_S=15
# fal 프롬프트 상한(UTF-8 바이트, 073 D5·R5.1). 형식 글롭=바이트[,글롭=바이트…](endpoint id, 소문자 비교, 첫 번째로
# 맞는 값). 기본은 Seedance 2.5 계열을 BytePlus 와 같은 4,000 으로 둔다. 넘으면 문장 경계에서 자르고 ④ 에
# 실제로 보낸 문장과 잘린 크기를 보인다. 빈 값이면 덮어쓰기 없음(caps promptMaxLength, 없으면 2,500).
# fal 이 긴 프롬프트를 거절하면(유료 검증 V-4) 이 값만 낮춘다.
VPOC_FAL_PROMPT_MAX_OVERRIDES=bytedance/seedance-2.5/*=4000
# fal Seedance 계열 r2v 프롬프트의 참고 이미지 지칭(073 R5.7). at = "@Image1 is …", plain = "Image 1 is …".
# 빈 값·틀린 값은 at. ③ 미리보기 문장도 같은 방식이다. ARK·계열이 아닌 fal 모델은 이 값과 상관없이 plain.
# 유료 검증 V-2 가 실패하면 config.<target>.env 에서 plain 으로 덮는다(다음 제출부터 적용).
VPOC_FAL_SEEDANCE_TAG_STYLE=at
# 영상 결과 조회 포기 시간(초, 073 R15, 2026-10-27). 결과 조회가 연속 5회 실패하고 제출 뒤 이 시간이 지나면
# 샷을 failed("결과를 가져오지 못했습니다(…)")로 끝낸다. 전에는 조회 실패 샷이 "생성 중"에 영원히 멈췄다.
# 공급자 대기열이 길어 정상 샷이 포기되면 이 값만 늘린다. 최소 60(그보다 작으면 60으로 읽는다).
VPOC_POLL_GIVEUP_S=1800

# dual-style(실사+애니, 설계자 2026-10-20). 화풍을 고르지 않고 항상 실사 영상을 먼저 만든 뒤
# 그 실사 영상을 애니(웹툰풍)로 변환해 두 결과를 함께 본다. 기본 false(dev·prod config 는 true).
# FAL_KEY(fal-api-key Secret)가 없으면 변환은 건너뛰고(애니 결과에 "변환 키 없음") 실사는 정상 진행.
VPOC_DUAL_STYLE_ENABLED=false
# 실사 → 애니 변환 모델(실측 2026-10-20: fal video-to-video edit). 입력 영상은 3~15초·높이 ≥720px.
VPOC_ANIME_MODEL=fal-ai/kling-video/o3/standard/video-to-video/edit
# 변환 1초당 USD(실측 2026-10-20).
VPOC_ANIME_USD_PER_S=0.14

# --- vpoc2 영상 기능 (2026-09-30) ---
# 명령 → 캐릭터 확정 → 15초(5초 × 3샷) → 리뷰. /vpoc2.html · /api/vpoc2.
# 주 버킷은 S3_BUCKET, 영상 버킷은 VPOC_VIDEO_BUCKET 을 같이 쓴다(접두사 users/*/video/_vpoc2/).
# 문제가 생기면 이 값만 false 로 바꿔 배포하면 /api/vpoc2 가 사라진다. vpoc1 에는 영향이 없다.
VPOC2_ENABLED=true
