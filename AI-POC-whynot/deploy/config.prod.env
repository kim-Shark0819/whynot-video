# whynot 운영 오버레이 — 고객사 계정(089540175779) EKS
#
# 사용법
#   python AI-POC-whynot/deploy/render.py --target prod
#
# 이 파일은 CI 의 deploy:whynot:prod 잡이 읽는다. 개발계(config.env.example 만 사용)와 다른 값만 둔다.
# 공통 값(모델 카탈로그, 참고 이미지 상한 등)은 config.env.example 한 곳에만 있다.
#
# **비밀값은 여기 없다.** 관리자 비밀번호·시드 사용자·회사 코드는 고객 클러스터의
# Secret whynot-auth 에만 있고 매니페스트는 그것을 참조한다.
#
# 배포는 GitLab 파이프라인의 수동 버튼으로만 일어난다. deploy.ps1 은 거부한다.

# --- 계정 ---
# 앱이 도는 계정(고객). account_guard 의 EXPECTED_ACCOUNT_ID 와 Bedrock 정책 조건이 이 값을 쓴다.
AWS_ACCOUNT_ID=089540175779
# 이미지를 가져올 계정(우리). 교차 계정 pull 을 ECR 리포지토리 정책으로 허용해 두었다.
ECR_ACCOUNT_ID=730335451955

# --- 자격증명 (운영은 ArgoCD 가 배포하므로 로컬 스크립트용 값은 쓰이지 않는다) ---
CREDENTIALS_FILE=통합계정.json
CREDENTIALS_ACCESS_NAME=kiro-iam-mtx

# --- 대상 클러스터 (고객 계정) ---
EKS_CLUSTER_NAME=whynot-prod-eks
EKS_OIDC_ID=B8C9DC772CB520B3FAE8B0B34F04E29A
EKS_CLUSTER_SECURITY_GROUP=sg-02155da2613cfb2b6
# 고객 계정에는 배스천이 없다. ArgoCD 가 원격으로 배포한다.
BASTION_INSTANCE_ID=

# --- 네트워크 (고객 계정) ---
VPC_ID=vpc-02fc3bdbd9742e5bf
# 2b (subnet-00500ef64cc06282f) was removed on 2026-10-02 to recover one Elastic
# IP: the internet-facing production ALB takes one EIP per AZ and this account is
# at its default quota of 5. Safe because both target groups have all their
# healthy targets in 2c; the ALB keeps 2a and 2c, meeting the two-AZ minimum.
# Do not add 2b back without checking the EIP headroom first.
# See docs/dev-migration/eip-quota-analysis.md
PUBLIC_SUBNET_IDS=subnet-0cd08744dd0f2d8a1,subnet-0d891ac2d6fc88001
PRIVATE_SUBNET_IDS=subnet-0ce973cbe66bc52fe,subnet-06927b54378cef9a5,subnet-0e9bc1e40b925f2f6

# --- 도메인 / TLS ---
# 도메인은 우리 Route53(meta-clouds.com), 인증서는 고객 계정 ACM 이다.
# 와일드카드 인증서는 계정 간 공유가 안 되어 단일 도메인으로 발급했다.
APP_DOMAIN=whynot.meta-clouds.com
ROUTE53_HOSTED_ZONE_ID=Z0217882389GDS0BZDMYR
# 2026-10-07 설계자 지시: 고객 계정 인증서를 *.meta-clouds.com 하나로 통일(이전 be286b80 은 교체 후 삭제).
ACM_CERTIFICATE_ARN=arn:aws:acm:ap-northeast-2:089540175779:certificate/2fddadd9-0fd7-414d-a223-9dcf8ac070c0

# --- 저장소 (고객 계정) ---
S3_BUCKET=whynot-089540175779
# 영상 raw 출력 버킷. **반드시 여기서 덮어써야 한다.**
#
# config.env.example 의 값은 우리 계정 버킷(whynot-video-730335451955-us-west-2)이다.
# 이 값을 비우지 않으면 고객 계정에서 도는 앱이 우리 계정 버킷을 가리키고,
# 그 계정의 whynot-app-role 에는 권한이 없어 AccessDenied 가 사용자에게 보인다.
#
# 고객 계정에 아직 영상 버킷이 없다. 비워 두면 provider 가 제출 전에
# `영상 출력 버킷이 설정되지 않았습니다` 로 막는다(require_output_bucket).
# 원인을 정확히 가리키는 쪽이라 빈 값이 맞다.
#
# 열 때: 고객 계정 us-west-2 에 버킷을 만들고(28-whynot 과 같은 구성) 그 계정의
# whynot-s3-access 에 ARN 을 넣은 뒤 이 값을 채운다. 그 작업은 고객 계정 소관이라
# 28-whynot 범위 밖이다.
S3_VIDEO_BUCKET=
# 두 번째(legacy) 출력 버킷도 **반드시 비운다.**
#
# 2026-09-19 에 base 의 legacy 값이 우리 계정 버킷
# (whynot-video-730335451955-us-west-2)으로 채워졌다. 여기서 비우지 않으면 고객 계정에서
# 도는 앱이 우리 계정 버킷을 읽으려 하고, 그 계정 역할에 권한이 없어 AccessDenied 가
# 사용자에게 보인다. base 를 바꿀 때마다 이 오버레이를 같이 봐야 한다.
# `check_render_config.py` 가 dev 계정 버킷이 prod 로 새는지 검사한다.
S3_VIDEO_LEGACY_BUCKET=
NEPTUNE_ENDPOINT=whynot-graph-v2.cluster-cdqeg08woy0c.ap-northeast-2.neptune.amazonaws.com
NEPTUNE_CLUSTER_ID=whynot-graph-v2
NEPTUNE_SECURITY_GROUP=sg-04a8d178abec366c8

# --- IAM (고객 계정) ---
IAM_APP_ROLE_NAME=whynot-app-role
IAM_APP_POLICY_NAME=whynot-s3-access

# --- ALB ---
ALB_NAME=whynot-prod-alb

# --- Whynot PRD 9단계 ---
# 2026-09-30 설계자 지시로 운영 영상(vpoc1 '영상 만들기')을 다시 연다.
# 9/17 부터 꺼져 있었다(당시엔 고객 계정에 영상 버킷이 없었다). 버킷·권한은 MR !211 로 준비했다.
VIDEO_GEN_ENABLED=true
# 이야기 분석·기준 이미지의 Bedrock 호출.
# 2026-10-07 설계자 지시("개발에서 진행했던 것을 운영에도 그대로")로 개발계와 같은 real 로 연다.
STORY_MODEL_MODE=real
# 새 창·새 탭에서 다시 로그인하지 않게 한다(설계자 2026-10-07, 운영만).
PERSIST_LOGIN=true

# --- 배포 경로 ---
DEPLOY_MANAGED_BY=argocd
# 영상 provider. 2026-10-07 개발계와 같은 Luma 로 맞춘다(설계자 지시).
SCENE_VIDEO_PROVIDER=bedrock_luma
# --- vpoc1 영상 기능 (운영) ---
# 운영 영상 = vpoc1(개발계 검증 완료, docs/vpoc1). vpoc2 는 아래에서 계속 끈다.
VPOC_ENABLED=true
# 오류 원문 노출은 dev 전용이다(D-L06).
VPOC_RAW_ERRORS=false
# 테스트 페이지는 운영에 두지 않는다.
VPOC_SMOKE_ENABLED=false
# 고객 계정 버킷(2026-09-30 생성, users/ 자동 삭제 규칙 없음). 권한은 whynot-app-role 의
# 인라인 vpoc-video-bucket 과 whynot-s3-access v2. 기록은 platform/docs/cli-created.md.
VPOC_VIDEO_BUCKET=whynot-video-089540175779-us-west-2
# 영상 재생성(의견 반영·버전 선택) — 개발계 검증 완료(vpoc-regen).
VPOC_REGEN_ENABLED=true
# vpoc2 — 2026-10-07 설계자 지시로 운영에도 연다(개발계와 동일).
VPOC2_ENABLED=true
