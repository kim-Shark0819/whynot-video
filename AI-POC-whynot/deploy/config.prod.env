# whynot 운영 오버레이 — 고객사 계정(089540175779) EKS
#
# 사용법
#   python AI-POC-whynot/deploy/render.py --target prod
#
# 이 파일은 CI 의 deploy:whynot:prod 잡이 읽는다. 개발계(config.env.example 만 사용)와 다른 값만 둔다.
# 공통 값(모델 카탈로그, 참고 이미지 상한 등)은 config.env.example 한 곳에만 있다.
#
# **비밀값은 여기 없다.** 관리자 비밀번호·시드 사용자·회사 코드는 고객 클러스터의
# Secret whynot-auth 에만 있고 매니페스트는 그것을 참조한다.
#
# 배포는 GitLab 파이프라인의 수동 버튼으로만 일어난다. deploy.ps1 은 거부한다.

# --- 계정 ---
# 앱이 도는 계정(고객). account_guard 의 EXPECTED_ACCOUNT_ID 와 Bedrock 정책 조건이 이 값을 쓴다.
AWS_ACCOUNT_ID=089540175779
# 이미지를 가져올 계정. 2026-10-19 통합계정(730335451955)에서 고객 계정으로 이전했다 —
# 운영 이미지를 고객 계정 ECR(whynot-app / whynot-frontend)로 옮기고 운영 파드도 그 주소로
# 전환했다. 이제 같은 계정에서 pull 하므로 교차 계정 ECR 리포지토리 정책은 더 필요하지 않다.
ECR_ACCOUNT_ID=089540175779

# --- 자격증명 (운영은 ArgoCD 가 배포하므로 로컬 스크립트용 값은 쓰이지 않는다) ---
CREDENTIALS_FILE=통합계정.json
CREDENTIALS_ACCESS_NAME=kiro-iam-mtx

# --- 대상 클러스터 (고객 계정) ---
EKS_CLUSTER_NAME=whynot-prod-eks
EKS_OIDC_ID=B8C9DC772CB520B3FAE8B0B34F04E29A
EKS_CLUSTER_SECURITY_GROUP=sg-02155da2613cfb2b6
# 고객 계정에는 배스천이 없다. ArgoCD 가 원격으로 배포한다.
BASTION_INSTANCE_ID=

# --- 네트워크 (고객 계정) ---
VPC_ID=vpc-02fc3bdbd9742e5bf
# 2b (subnet-00500ef64cc06282f) was removed on 2026-10-02 to recover one Elastic
# IP: the internet-facing production ALB takes one EIP per AZ and this account is
# at its default quota of 5. The ALB keeps 2a and 2c, meeting the two-AZ minimum.
# The ALB uses target-type ip, so it only sends traffic to pods in its own AZs;
# a pod in 2b is registered as Target.NotInUse. On 2026-10-31 both new frontend
# pods landed on a 2b node and / returned 503 for about 7 minutes.
# On 2026-11-07 2b was dropped for prod and dev. The prod nodes are now the
# nodegroup whynot-prod-ng-m6i2x-ac: 6 x m6i.2xlarge in the 2a and 2c private
# subnets only, 3 per AZ (it replaces the old 3-AZ nodegroup). POD_ZONES below
# keeps the frontend and app pods in 2a/2c, and the zone spread rule in
# k8s/workloads.yaml.tmpl spreads each Deployment's pods over different zones:
# app runs 6 pods (3 in 2a, 3 in 2c) and the frontend runs 2 pods (one per AZ).
# POD_ZONES must equal the AZs of these ALB subnets. If you add 2b back, add
# ap-northeast-2b to POD_ZONES in the same change.
# Do not add 2b back without checking the EIP headroom first.
# See docs/dev-migration/eip-quota-analysis.md
PUBLIC_SUBNET_IDS=subnet-0cd08744dd0f2d8a1,subnet-0d891ac2d6fc88001
# frontend·app 파드를 띄울 AZ(쉼표, 공백 없이). ALB 서브넷(PUBLIC_SUBNET_IDS)과 같은 AZ 만 적는다.
# 다르면 ALB 가 파드를 대상으로 쓰지 못해 503 이 난다(2026-10-31). 2026-11-07 부터 2b 는 운영·개발 모두 쓰지 않고,
# 운영 노드는 2a·2c 전용 노드그룹(whynot-prod-ng-m6i2x-ac) 6대(영역마다 3대)다. 영역 분산 규칙(workloads.yaml.tmpl)으로
# app 파드 6개는 2a·2c 에 3개씩, frontend 파드 2개는 영역마다 1개씩 뜬다. 서브넷 수와 이 목록의 수는
# 같아야 한다(tools/check_vpoc.py pz-a 가 본다).
POD_ZONES=ap-northeast-2a,ap-northeast-2c
PRIVATE_SUBNET_IDS=subnet-0ce973cbe66bc52fe,subnet-06927b54378cef9a5,subnet-0e9bc1e40b925f2f6

# --- 도메인 / TLS ---
# 도메인은 우리 Route53(meta-clouds.com), 인증서는 고객 계정 ACM 이다.
# 와일드카드 인증서는 계정 간 공유가 안 되어 단일 도메인으로 발급했다.
APP_DOMAIN=whynot.meta-clouds.com
ROUTE53_HOSTED_ZONE_ID=Z0217882389GDS0BZDMYR
# 2026-10-07 설계자 지시: 고객 계정 인증서를 *.meta-clouds.com 하나로 통일(이전 be286b80 은 교체 후 삭제).
ACM_CERTIFICATE_ARN=arn:aws:acm:ap-northeast-2:089540175779:certificate/2fddadd9-0fd7-414d-a223-9dcf8ac070c0

# --- 저장소 (고객 계정) ---
S3_BUCKET=whynot-089540175779
# 영상 raw 출력 버킷. **반드시 여기서 덮어써야 한다.**
#
# config.env.example 의 값은 개발계(통합계정 730335451955) 버킷
# (whynot-video-730335451955-us-west-2)이다. 운영 ECR 은 2026-10-19 고객 계정으로 옮겼지만,
# 이 버킷은 개발계 값이라 통합계정 그대로다 — 운영 오버레이에서 비워 고객 앱이 당기지 않게 한다.
# 이 값을 비우지 않으면 고객 계정에서 도는 앱이 통합계정 버킷을 가리키고,
# 그 계정의 whynot-app-role 에는 권한이 없어 AccessDenied 가 사용자에게 보인다.
#
# 고객 계정에 아직 영상 버킷이 없다. 비워 두면 provider 가 제출 전에
# `영상 출력 버킷이 설정되지 않았습니다` 로 막는다(require_output_bucket).
# 원인을 정확히 가리키는 쪽이라 빈 값이 맞다.
#
# 열 때: 고객 계정 us-west-2 에 버킷을 만들고(28-whynot 과 같은 구성) 그 계정의
# whynot-s3-access 에 ARN 을 넣은 뒤 이 값을 채운다. 그 작업은 고객 계정 소관이라
# 28-whynot 범위 밖이다.
S3_VIDEO_BUCKET=
# 두 번째(legacy) 출력 버킷도 **반드시 비운다.**
#
# 2026-09-19 에 base 의 legacy 값이 개발계(통합계정 730335451955) 버킷
# (whynot-video-730335451955-us-west-2)으로 채워졌다. 운영 ECR 은 2026-10-19 고객 계정으로
# 옮겼지만 이 버킷은 개발계 값이라 통합계정 그대로다. 여기서 비우지 않으면 고객 계정에서
# 도는 앱이 통합계정 버킷을 읽으려 하고, 그 계정 역할에 권한이 없어 AccessDenied 가
# 사용자에게 보인다. base 를 바꿀 때마다 이 오버레이를 같이 봐야 한다.
# `check_render_config.py` 가 dev 계정 버킷이 prod 로 새는지 검사한다.
S3_VIDEO_LEGACY_BUCKET=
NEPTUNE_ENDPOINT=whynot-graph-v2.cluster-cdqeg08woy0c.ap-northeast-2.neptune.amazonaws.com
NEPTUNE_CLUSTER_ID=whynot-graph-v2
NEPTUNE_SECURITY_GROUP=sg-04a8d178abec366c8

# --- IAM (고객 계정) ---
IAM_APP_ROLE_NAME=whynot-app-role
IAM_APP_POLICY_NAME=whynot-s3-access

# --- ALB ---
ALB_NAME=whynot-prod-alb

# --- Whynot PRD 9단계 ---
# 2026-09-30 설계자 지시로 운영 영상(vpoc1 '영상 만들기')을 다시 연다.
# 9/17 부터 꺼져 있었다(당시엔 고객 계정에 영상 버킷이 없었다). 버킷·권한은 MR !211 로 준비했다.
VIDEO_GEN_ENABLED=true
# 이야기 분석·기준 이미지의 Bedrock 호출.
# 2026-10-07 설계자 지시("개발에서 진행했던 것을 운영에도 그대로")로 개발계와 같은 real 로 연다.
STORY_MODEL_MODE=real
# 새 창·새 탭에서 다시 로그인하지 않게 한다(설계자 2026-10-07, 운영만).
PERSIST_LOGIN=true
# 로그인 후 1회 안내 팝업(운영 노드 교체 중 약 10초 접속이 끊긴 일 안내). 운영에만 띄운다(설계자 2026-10-19).
NOTICE_SPECUP_ENABLED=true

# --- 배포 경로 ---
DEPLOY_MANAGED_BY=argocd

# --- 파드 자원 (운영만, 설계자 2026-10-19) ---
# 운영 노드를 t3.medium ×2 → m6i.2xlarge(8 vCPU · 32GiB) ×2 로 키웠으나 파드 한도가 그대로라
# 체감 성능이 오르지 않았다. 운영에서만 한도를 올린다. 개발계(config.env.example)는 지금 값 유지.
# app 한도는 영상 이어 붙이기(ffmpeg) 를 고려해 크게 잡는다.
# 2026-11-07 운영 노드 m6i.2xlarge 3 → 6대(2a·2c 전용 노드그룹, 영역마다 3대, 사용자 지시). ALB 가 2a·2c 만 쓰므로
# app 파드는 2a·2c 의 노드 6대에 한 개씩(영역 분산 3+3). 요청을 키워 한 노드에 몰리지 않게 하고, 한도는 ffmpeg 이어
# 붙이기 여유로 올린다. 요청 2 CPU 면 롤링 중 surge 파드가 같은 노드에 와도 8 vCPU 안이다. frontend 는 2개 그대로.
APP_REPLICAS=6
APP_CPU_REQUEST=2
APP_MEM_REQUEST=4Gi
APP_CPU_LIMIT=6
APP_MEM_LIMIT=16Gi
FRONTEND_CPU_REQUEST=100m
FRONTEND_MEM_REQUEST=128Mi
FRONTEND_CPU_LIMIT=500m
FRONTEND_MEM_LIMIT=256Mi
# 영상 provider. 2026-10-07 개발계와 같은 Luma 로 맞춘다(설계자 지시).
SCENE_VIDEO_PROVIDER=bedrock_luma
# --- vpoc1 영상 기능 (운영) ---
# 운영 영상 = vpoc1(개발계 검증 완료, docs/vpoc1). vpoc2 는 아래에서 계속 끈다.
VPOC_ENABLED=true
# 오류 원문 노출은 dev 전용이다(D-L06).
VPOC_RAW_ERRORS=false
# 테스트 페이지는 운영에 두지 않는다.
VPOC_SMOKE_ENABLED=false
# 고객 계정 버킷(2026-09-30 생성, users/ 자동 삭제 규칙 없음). 권한은 whynot-app-role 의
# 인라인 vpoc-video-bucket 과 whynot-s3-access v2. 기록은 platform/docs/cli-created.md.
VPOC_VIDEO_BUCKET=whynot-video-089540175779-us-west-2
# 영상 재생성(의견 반영·버전 선택) — 개발계 검증 완료(vpoc-regen).
VPOC_REGEN_ENABLED=true
# vpoc2 — 2026-10-07 설계자 지시로 운영에도 연다(개발계와 동일).
VPOC2_ENABLED=true
# ② 영상 모델 고르기 · ③ 화질/샷 길이 · 한 번에 이어서 만들기 — 2026-10-08 설계자 지시로 운영에도 연다.
# Seedance 는 운영 클러스터 Secret seedance-api-key(ark-api-key)가 있어야 고를 수 있다. 없으면 화면에
# "API 키 미설정"으로 보이고 Luma Ray2 만 쓰인다. 결과 영상은 VPOC_VIDEO_BUCKET 에 저장된다.
VPOC_MODEL_PICKER_ENABLED=true
# fal.ai API 키 Secret 이름(설계자 2026-10-18). 키 값은 Secret 의 fal-api-key 에만 둔다.
# Secret 이 없으면 fal 모델은 "fal API 키 미설정"으로 보이고 Luma/Seedance 만 쓰인다.
FAL_SECRET_NAME=fal-api-key
# 2026-10-30 사용자 결정("seedance도 사용할 수 있고 fal seedance도 사용할 수 있게 해라"): BytePlus Seedance와 fal Seedance 둘 다 ②에 보인다.
# 2026-11-04: BytePlus ARK 키가 사라짐("The API key doesn't exist") + 사용자 "byteplus가 아니라 fal.ai를 쓰라고 했잖아" → false. 저장된 seedance 모델은 fal 로 간다.
VPOC_ARK_SEEDANCE_ENABLED=false
# --- dual-style(실사+애니, 설계자 2026-10-20, 운영) ---
# 화풍을 고르지 않고 실사 + 애니(웹툰풍) 두 결과를 함께 만든다. base 기본값 false 를 true 로 덮어쓴다.
# 모델·단가는 base 기본값 그대로. 변환은 운영 Secret fal-api-key(FAL_KEY) 가 있어야 돈다 —
# 없으면 애니 결과에 "변환 키 없음"으로 보이고 실사는 정상 진행한다.
VPOC_DUAL_STYLE_ENABLED=true

# --- 영상만들기_신규(vnew, 설계자 2026-10-20, 운영) ---
# 2026-10-30 사용자 결정("운영에서 vnew 켠다"): 메뉴에 영상만들기_신규·캐릭터 만들기가 보인다. 되돌리기는 false + 운영 job.
# base 기본값은 false 라 운영 값은 여기서 명시한다.
VNEW_ENABLED=true
# 2026-11-02 사용자 승인: ⑦ 편집(영상 편집 타임라인)을 운영에서도 켠다(지시서 110·111, dev 화면 시험 통과). 끄기는 false + 운영 job.
VNEW_EDIT=true
# 2026-11-03 사용자 승인("운영에서 AI로 고치기 켜라"): 지시서 116 ⑦ AI로 고치기(유료 다시 만들기)를 운영에서 켠다. 끄기는 false + 운영 job.
VNEW_EDIT_RETAKE=true
# 2026-11-02 사용자 지시: 운영도 개발과 같이 만들기 창의 스토리 개발을 숨긴다(이미 있는 스토리 프로젝트·데이터는 그대로). 되돌리기는 false + 운영 job.
VNEW_HIDE_STORY=true
